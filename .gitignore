# Python virtual environment (regenerable, takes up space)
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Secrets / environment variables (never share these)
.env
.env.*
*.key

# macOS system files
.DS_Store

# Generated outputs (delete this line if you need them)
outputs/

# Local-only .bin test files derived from ExampleData.rda (deliberately not committed)
test_data/

# Editor / IDE settings
.vscode/
.idea/
.claude/

# R run byproducts (regenerated on every run)
Rplots.pdf
.Rapp.history
.Rhistory

# Local-only documents (not uploaded to the public repository — kept locally only)
#
# We deliberately don't use extension patterns (*.pdf, *.svg) here, since that would
# also block diagrams or reports we might want to upload later. Only name the files
# that must not be uploaded; anything else that becomes shareable will be committed
# without touching this file.

# Development proposal / internal planning notes: not this repo's call whether to publish
루미네선스 연대 해석을 위한 데이터 시각화 및 모델 추천 시스템 개발.pdf
멀티에이전트_계획.txt

# Institutional report: kept out of the public repo for the same reason as above
한국지질자원연구원 중간 보고서.hwpx

# Working notes: mixed in with internal discussion. New ones appear by date, hence the pattern
전체점검 및 수정*.txt
이슈정리_*.txt

# Code structure diagrams: fine to publish, just kept out of the repo for now.
# Delete the two lines below if you want to add them.
LumiGuide_코드구조_도식.pdf
LumiGuide_함수흐름도.svg
